    (COND D == 1'b1 && CK == 1'b0 (IOPATH (negedge RN) Q () (0.383:0.383:0.383)))
    (COND D == 1'b0 && CK == 1'b1 (IOPATH (negedge RN) Q () (0.379:0.379:0.379)))
    (COND D == 1'b1 && CK == 1'b1 (IOPATH (negedge RN) Q () (0.379:0.379:0.379)))
    )
  )
  (TIMINGCHECK
    (PERIOD CK (1.000:1.000:1.000))
    (SETUP (posedge D) (posedge CK) (0.299:0.301:0.301))
    (SETUP (negedge D) (posedge CK) (0.155:0.158:0.158))
    (HOLD (posedge D) (posedge CK) (-0.170:-0.172:-0.172))
    (HOLD (negedge D) (posedge CK) (-0.024:-0.027:-0.027))
    (SETUP (posedge RN) (posedge CK) (0.396:0.396:0.396))
    (HOLD (posedge RN) (posedge CK) (-0.298:-0.298:-0.298))
  )
)
